# ── 编译产物 ──────────────────────────────
*.exe
*.exe~
*.dll
*.so
*.dylib
__debug_bin*
studygo

# ── 测试产物 ──────────────────────────────
*.test
*.out
coverage.html

# ── Go 构建缓存 ───────────────────────────
# 用 GOPATH 默认位置时不会出现在仓库里，
# 但若在项目内设置 GOCACHE 就会生成这个目录
.gocache/
.cache/

# ── Go 工作区 ─────────────────────────────
go.work
go.work.sum

# ── 依赖目录 ──────────────────────────────
vendor/

# ── IDE ───────────────────────────────────
.idea/
.vscode/
*.iml
*.swp

# ── 环境变量（含密钥，绝不能提交）─────────
.env
.env.local
*.env

# ── 截图等临时素材 ────────────────────────
IMG/
*.log
tmp/

# ── 系统 ──────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
